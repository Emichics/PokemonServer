@{
    ViewData["Title"] = "Pokémon";
}
@section Scripts {
    <script type="module" src="~/js/site.js"></script>
}
<div class="row mb-4">
    <div class="col-md-3">
        <label for="pokemonName" class="form-label">
            Nombre
        </label>

        <input
            type="text"
            id="pokemonName"
            class="form-control"
            placeholder="Buscar por nombre..." />
    </div>

    <div class="col-md-3">
        <label for="pokemonGenus" class="form-label">
            Especie
        </label>

        <select id="pokemonGenus" class="form-select">
            <option value="">Todos</option>
        </select>
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button
            type="button"
            id="btnSearch"
            class="btn btn-primary w-100">
            Buscar
        </button>
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button
            type="button"
            id="btnExport"
            class="btn btn-success w-100">
            Exportar Excel
        </button>
    </div>

    <div class="col-md-2 d-flex align-items-end">
    <button
        type="button"
        id="btnSendEmail"
        class="btn btn-info w-100">
        Enviar correo
    </button>

</div>
</div>
<div class="container mt-4">
    <h1 class="mb-4">Pokémon</h1>

    <div class="table-responsive">
        <table class="table table-striped table-hover text-center align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Imagen</th>
                    <th>Nombre</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody id="pokemonGrid">
                <tr>
                    <td colspan="4" class="text-center">
                        Cargando...
                    </td>
                </tr>
            </tbody>
        </table>
        <div class="d-flex justify-content-between align-items-center mt-3"></div>
            <button
                type="button"
                id="btnPrevious"
                class="btn btn-secondary">
                Anterior
            </button>

            <span id="paginationInfo"></span>

            <button
                type="button"
                id="btnNext"
                class="btn btn-secondary">
                Siguiente
            </button>
        </div>
    </div>
</div>

<div class="modal fade" id="pokemonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="pokemonModalTitle">
                    Detalle del Pokémon
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Cerrar">
                </button>
            </div>

            <div class="modal-body">

                <div class="text-center mb-3">
                    <img
                        id="pokemonDetailImage"
                        src=""
                        alt=""
                        width="150"
                        height="150">
                </div>

                <p>
                    <strong>ID:</strong>
                    <span id="pokemonDetailId"></span>
                </p>

                <p>
                    <strong>Nombre:</strong>
                    <span id="pokemonDetailName"></span>
                </p>

                <p>
                    <strong>Altura:</strong>
                    <span id="pokemonDetailHeight"></span>
                </p>

                <p>
                    <strong>Peso:</strong>
                    <span id="pokemonDetailWeight"></span>
                </p>

                <p>
                    <strong>Tipos:</strong>
                    <span id="pokemonDetailTypes"></span>
                </p>

            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="emailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Enviar Pokémon por correo
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Cerrar">
                </button>
            </div>

            <div class="modal-body">

                <label for="emailInput" class="form-label">
                    Correo electrónico
                </label>

                <input
                    type="email"
                    id="emailInput"
                    class="form-control"
                    placeholder="correo@ejemplo.com" />

                <div
                    id="emailError"
                    class="text-danger mt-2">
                </div>

            </div>

            <div class="modal-footer">
                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button
                    type="button"
                    id="btnConfirmSendEmail"
                    class="btn btn-primary">
                    Enviar
                </button>
            </div>

        </div>
    </div>
</div>

<div
    id="loadingOverlay"
    class="position-fixed top-0 start-0 w-100 h-100 d-none"
    style="z-index: 9999; background-color: rgba(0, 0, 0, 0.5);">

    <div class="d-flex justify-content-center align-items-center h-100">
        <div class="text-center text-white">

            <div
                class="spinner-border"
                role="status">
            </div>

            <div class="mt-2">
                Procesando...
            </div>

        </div>
    </div>

</div>